# Copy to .env for local overrides. Vite only exposes vars prefixed with VITE_.

# Backend API base URL (must end with /api)
VITE_API_URL=http://127.0.0.1:8000/api

# Same Key ID as Razorpay dashboard (test or live). Optional if server returns key_id on order create.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
