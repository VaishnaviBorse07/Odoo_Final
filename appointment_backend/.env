# =============================================================================
# ZenFlow API — local environment (copy from .env.example, then fill secrets)
# =============================================================================

# --- Database (URL-encode special chars in password: @=%40, #=%23) ----------
DATABASE_URL=postgresql://postgres:vaishu@localhost:5432/zenflow_db

# --- Auth -------------------------------------------------------------------
JWT_SECRET=zenflow_super_secret_key_change_me
JWT_EXPIRES_IN=7d

# --- Server -----------------------------------------------------------------
PORT=8000

# --- OTP (signup / forgot password) -----------------------------------------
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MINUTE=3
OTP_EMAIL_SUBJECT_PREFIX=ZenFlow
# true = return otp_code in API (local only). false = email only in production.
DEV_RETURN_OTP=true

# --- SMTP (Gmail: use App Password, not account password) -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=vaishnaviborse2005@gmail.com
SMTP_PASSWORD="vjer kpcy fkzr yzbl"
SMTP_FROM=vaishnaviborse2005@gmail.com

# --- Razorpay (https://dashboard.razorpay.com) ------------------------------
RAZORPAY_KEY_ID=rzp_test_SkOanfjxTiW4Nx
