# Copy to .env in this folder (appointment_backend/) before running: python run_dev.py
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/zenflow_db
JWT_SECRET=zenflow_super_secret_key_change_me
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10
PORT=8000
# Local / hackathon: echo OTP in JSON (never enable in public production).
DEV_RETURN_OTP=true

# Razorpay (https://dashboard.razorpay.com) — test mode keys for development.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here
