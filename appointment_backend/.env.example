# Copy to .env and replace placeholder values. Never commit .env.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/zenflow_db

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Server -----------------------------------------------------------------
PORT=8000

# --- OTP --------------------------------------------------------------------
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MINUTE=3
OTP_EMAIL_SUBJECT_PREFIX=ZenFlow
# Local dev only — set false when SMTP is configured for real email OTP.
DEV_RETURN_OTP=false

# --- SMTP (required for email OTP unless DEV_RETURN_OTP=true) --------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# --- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=
